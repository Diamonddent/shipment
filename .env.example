# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Google Cloud OAuth 2.0 Web client ID (for Google Drive document storage)
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Base path the app is served from. GitHub Pages project site: /shipment/
# Use / for a custom domain or local root hosting.
VITE_BASE_PATH=/shipment/
